            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveler.abebe@guzomate.et\",\n  \"password\": \"Password123!\",\n  \"name\": \"Abebe Bikila\",\n  \"preferredLanguage\": \"am\"\n}"
