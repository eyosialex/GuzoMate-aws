    {
      "name": "4. Confirmations & Consensus (/api/v1/incidents/:id/confirm)",
      "description": "Community consensus voting, auto-activation thresholds (3 confirmations), dispute flagging, and vote lockouts.",
      "item": [
        {
          "name": "4.1 Reporter Self-Vote Lockout Guard (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"CONFIRM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "confirm"
              ]
            },
            "description": "Verifies the business rule prohibiting reporters from voting on their own submissions."
          },
          "response": []
        },
        {
          "name": "4.2 Community Confirmation Vote (Voter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{voterToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"CONFIRM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "confirm"
              ]
            },
            "description": "Second traveler confirms road hazard. Increments confirmationsCount atomically."
          },
          "response": []
        },
        {
          "name": "4.3 Duplicate Vote Conflict Guard (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{voterToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"CONFIRM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "confirm"
              ]
            },
            "description": "Verifies that voting with the exact same action returns 409 Conflict."
          },
          "response": []
        },
        {
          "name": "4.4 Atomic Vote Switch to DISPUTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{voterToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"DISPUTE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}",
                "confirm"
              ]
            },
            "description": "Switches voter's existing vote from CONFIRM to DISPUTE. Adjusts tallies atomically."
          },
          "response": []
        }
      ]
    },
