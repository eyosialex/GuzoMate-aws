# ==============================================================================
# GuzoMate Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Choose ONE: Supabase Cloud OR Local Docker)
# ------------------------------------------------------------------------------
# Option A: Supabase Cloud Database (RECOMMENDED for team collaboration)
# Allows all contributors to read/write the same Addis Ababa POIs and vectors
DATABASE_URL=postgresql://postgres.jdbdgcrmmtbkelkmsiug:Eyosi%231234%40Eyosi@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Option B: Local Docker PostgreSQL (if working completely offline)
# DATABASE_URL=postgresql://guzomate:guzomate_dev_password@localhost:5432/guzomate

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. AI & ML Configuration
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# 4. External Services (to be configured as features are developed)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# WEATHER_API_KEY=
