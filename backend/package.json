{
  "name": "guzomate-backend",
  "version": "1.0.0",
  "description": "GuzoMate Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed:rag": "tsx database/seeds/seed-rag.ts",
    "ingest:transit": "/home/eyob/.venv/bin/python ../ai-ml/src/embeddings/embed_and_push_to_supabase.py",
    "test:assistant": "tsx src/modules/assistant/__tests__/assistant.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/auth.test.ts && vitest run tests/google-auth.test.ts && vitest run tests/users.test.ts && vitest run tests/incidents.test.ts && vitest run tests/confirmations.test.ts && vitest run tests/moderation.test.ts && vitest run tests/notifications.test.ts && vitest run tests/travel-services.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
