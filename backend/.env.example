# Server configuration
PORT=8000
NODE_ENV=development

# Database connection (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql://guzomate:guzomate_dev_password@localhost:5432/guzomate

# Google Gemini API configuration (AI Assistant & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=1024

# External Provider Configuration (Travel Services)
# WEATHER_API_KEY=your_weather_api_key_here
WEATHER_URL=https://open-meteo.com
ADDIS_TRANSIT_API_URL=
ADDIS_AI_API_KEY=

# ==============================================================================
# GuzoMate Backend Environment Variables Template
# Copy this file to .env and configure your database and environment settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection
# ------------------------------------------------------------------------------
# Primary database connection string for Prisma and pg Pool
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"

# Optional direct connection URL for Prisma migrations when using connection poolers (e.g. Supabase, PgBouncer)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. AI & Embeddings Configuration
# ------------------------------------------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-m3