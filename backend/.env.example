# ==============================================================================
# GuzoMate Backend Environment Variables Template
# Copy this file to .env and configure your database and environment settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL + PostGIS + pgvector)
# ------------------------------------------------------------------------------
# Runtime Prisma connection (port 6543 for Supabase PgBouncer pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (port 5432 for session mode)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3.1 AfroMessage SMS & OTP Configuration
# ------------------------------------------------------------------------------
AFROMESSAGE_API_TOKEN="your_afromessage_api_bearer_token"
AFROMESSAGE_SENDER_ID=""
AFROMESSAGE_IDENTIFIER_ID=""
AFROMESSAGE_BASE_URL="https://api.afromessage.com/api"
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Set to true only in development/testing to return/log OTPs for debugging
DEV_EXPOSE_OTP=false

# ------------------------------------------------------------------------------
# 4. Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 5. Push Notifications (Firebase Cloud Messaging)
# Optional: If omitted, the system seamlessly defaults to MockNotificationProvider
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 6. AI & Embeddings Configuration
# ------------------------------------------------------------------------------
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# 7. Member 3: Travel Services Configuration (Weather, Routing, Speech)
# ------------------------------------------------------------------------------
# WeatherAPI key from https://www.weatherapi.com/
WEATHER_API_KEY=""
WEATHER_URL="https://api.weatherapi.com/v1"
WEATHER_CACHE_TTL_MINUTES=20
WEATHER_REQUEST_TIMEOUT_MS=10000

# Routing Engine (OSRM / Open Source Routing Machine)
OSRM_BASE_URL="https://router.project-osrm.org"
ROUTING_REQUEST_TIMEOUT_MS=10000

# Addis AI Speech Services (Addis Assistant STT & TTS)
ADDIS_AI_API_KEY=""
ADDIS_AI_BASE_URL="https://api.addisassistant.com"
SPEECH_MAX_AUDIO_SIZE_BYTES=10485760
SPEECH_REQUEST_TIMEOUT_MS=15000

