datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, vector, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  USER
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Language {
  EN @map("en")
  AM @map("am")
  OM @map("om")

  @@map("language_code")
}

enum IncidentType {
  ACCIDENT
  ROAD_BLOCK
  ROAD_CLOSURE
  FLOODING
  LANDSLIDE
  ROAD_DAMAGE
  CONSTRUCTION
  HEAVY_TRAFFIC
  HAZARD
  OTHER

  @@map("incident_type")
}

enum IncidentStatus {
  PENDING
  ACTIVE
  RESOLVED
  REJECTED
  EXPIRED

  @@map("incident_status")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("incident_severity")
}

enum VerificationStatus {
  UNVERIFIED
  COMMUNITY_CONFIRMED
  MODERATOR_VERIFIED

  @@map("verification_status")
}

enum ConfirmationType {
  CONFIRM
  DISPUTE
  STILL_PRESENT
  RESOLVED
  INACCURATE

  @@map("confirmation_type")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String?    @unique @db.VarChar(255)
  phoneNumber       String?    @unique @map("phone_number") @db.VarChar(32)
  isPhoneVerified   Boolean    @default(false) @map("is_phone_verified")
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  name              String?    @db.VarChar(255)
  preferredLanguage Language   @default(EN) @map("preferred_language")
  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedPlaces               SavedPlace[]
  reportedIncidents         Incident[]
  incidentConfirmations     IncidentConfirmation[]
  notificationSubscriptions NotificationSubscription[]
  notifications             Notification[]
  deviceTokens              DeviceToken[]
  auditLogs                 AuditLog[]

  @@map("users")
}

model Place {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osmType         String?                                @map("osm_type") @db.VarChar(32)
  osmId           String?                                @map("osm_id") @db.VarChar(64)
  name            String?                                @db.VarChar(255)
  category        String                                 @db.VarChar(64)
  tags            Json?                                  @db.JsonB
  address         String?                                @db.Text
  latitude        Float?
  longitude       Float?
  location        Unsupported("geography(Point, 4326)")?
  sourceUpdatedAt DateTime?                              @map("source_updated_at") @db.Timestamptz(6)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedBy SavedPlace[]

  @@unique([osmType, osmId])
  @@index([category])
  @@index([name])
  @@map("places")
}

model SavedPlace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
  @@map("saved_places")
}

model Incident {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId         String?                                @map("reporter_id") @db.Uuid
  type               IncidentType
  description        String                                 @db.Text
  latitude           Float?
  longitude          Float?
  location           Unsupported("geography(Point, 4326)")?
  status             IncidentStatus                         @default(PENDING)
  severity           IncidentSeverity?
  verification       VerificationStatus                     @default(UNVERIFIED)
  confirmationsCount Int                                    @default(0) @map("confirmations_count")
  disputesCount      Int                                    @default(0) @map("disputes_count")
  occurredAt         DateTime?                              @map("occurred_at") @db.Timestamptz(6)
  expiresAt          DateTime?                              @map("expires_at") @db.Timestamptz(6)
  evidenceUrl        String?                                @map("evidence_url") @db.VarChar(1024)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter      User?                  @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  confirmations IncidentConfirmation[]
  notifications Notification[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([reporterId])
  @@map("incidents")
}

model IncidentConfirmation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  confirmationType ConfirmationType @map("confirmation_type")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([incidentId])
  @@index([userId])
  @@map("incident_confirmations")
}

model NotificationSubscription {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  enabled       Boolean        @default(true)
  radiusMeters  Int            @default(5000) @map("radius_meters")
  incidentTypes IncidentType[] @map("incident_types")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_subscriptions")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  incidentId     String?   @map("incident_id") @db.Uuid
  type           String    @db.VarChar(64)
  title          String    @db.VarChar(255)
  message        String    @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  deliveryStatus String    @default("PENDING") @map("delivery_status") @db.VarChar(32)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(512)
  platform  String   @default("web") @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model WeatherCache {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cacheKey     String   @unique @map("cache_key") @db.VarChar(255)
  latitude     Float
  longitude    Float
  provider     String   @default("weatherapi") @db.VarChar(64)
  forecastJson Json     @map("forecast_json") @db.JsonB
  retrievedAt  DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  validUntil   DateTime @map("valid_until") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([cacheKey])
  @@index([validUntil])
  @@map("weather_cache")
}

model RagDocument {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType String                       @map("source_type") @db.VarChar(64)
  sourceId   String?                      @map("source_id") @db.VarChar(255)
  language   String?                      @db.VarChar(10)
  title      String?                      @db.VarChar(255)
  content    String                       @db.Text
  metadata   Json?                        @db.JsonB
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sourceType, sourceId])
  @@index([language])
  @@map("rag_documents")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(128)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String   @map("target_id") @db.VarChar(255)
  reason      String?  @db.Text
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber       String    @map("phone_number") @db.VarChar(32)
  otpHash           String    @map("otp_hash") @db.VarChar(255)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime  @map("resend_available_at") @db.Timestamptz(6)
  isUsed            Boolean   @default(false) @map("is_used")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phoneNumber])
  @@index([phoneNumber, isUsed])
  @@map("otp_verifications")
}
